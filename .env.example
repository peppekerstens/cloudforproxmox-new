# ============================================================================
# Cloud Platform - Environment Variables
# ============================================================================
# 
# Copy this file to .env and fill in actual values for your environment.
# WARNING: .env is ignored by git and should NEVER be committed.
# 
# ============================================================================
# INFRASTRUCTURE & PROXMOX NODES
# ============================================================================
# Proxmox cluster node IPs
PVE1_IP=192.168.2.21
PVE2_IP=192.168.2.22

# Proxmox API endpoints
PROXMOX_URL_PVE1=https://192.168.2.21:8006
PROXMOX_URL_PVE2=https://192.168.2.22:8006

# VM deployment IPs
VM103_IP=192.168.2.186
VM151_IP=192.168.2.187

# Network configuration
NETWORK_GATEWAY=192.168.2.250
NETWORK_SUBNET=192.168.2.0/24
NETWORK_BRIDGE=vmbr0

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql+asyncpg://cloudplatform:cloudplatform_dev_password@postgres:5432/cloudplatform

# ============================================================================
# CACHE & MESSAGE QUEUE
# ============================================================================
REDIS_URL=redis://:cloudplatform_redis_password@redis:6379/0
CELERY_BROKER_URL=amqp://cloudplatform:cloudplatform_rabbit_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:cloudplatform_redis_password@redis:6379/1

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT secret key for token signing (min 32 characters)
# IMPORTANT: Generate a strong random key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# API URL for frontend to communicate with backend
# Set to the external IP/hostname of the API server
VITE_API_URL=http://192.168.2.186:8000/api/v1

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS
# Include all frontend URLs that will access this API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.2.186:3000

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# ============================================================================
# INITIAL ADMIN USER (FOR DEVELOPMENT ONLY)
# ============================================================================
# These are used by deployment scripts to seed the initial admin user.
# Change these before deploying to production!
# 
# WARNING: In production, use a secure credential management system:
# - AWS Secrets Manager
# - HashiCorp Vault
# - Kubernetes Secrets
# - Azure Key Vault
# 
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=superadmin
ADMIN_USERNAME=admin
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User

# ============================================================================
# PROXMOX INTEGRATION (FOR FUTURE USE)
# ============================================================================
# PROXMOX_API_HOST=192.168.2.100
# PROXMOX_API_USER=root@pam
# PROXMOX_API_TOKEN_ID=terraform-prov@pve
# PROXMOX_API_TOKEN_SECRET=<generated-token-secret>
# PROXMOX_VERIFY_SSL=false

# ============================================================================
# BILLING & STRIPE (FOR FUTURE USE)
# ============================================================================
# STRIPE_API_KEY=<stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

