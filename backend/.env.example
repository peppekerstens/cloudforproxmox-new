# Application
APP_NAME="Proxmox ISP API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql+asyncpg://proxmoxisp:dev_password_change_me@localhost:5432/proxmoxisp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Redis (cache + Celery broker)
REDIS_URL=redis://:dev_redis_password@localhost:6379/0
REDIS_CACHE_EXPIRATION=300

# JWT Authentication
JWT_SECRET_KEY=dev-jwt-secret-at-least-32-characters-long-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
PASSWORD_BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery (using Redis as both broker and result backend)
CELERY_BROKER_URL=redis://:dev_redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:dev_redis_password@localhost:6379/2

# Proxmox cluster (at least one required)
PROXMOX_HOST=pve1.example.com
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=root@pam!isp-portal
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Monitoring
ENABLE_METRICS=true
