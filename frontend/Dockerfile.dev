FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy entrypoint first and make executable
COPY entrypoint.sh ./
RUN chmod +x ./entrypoint.sh

# Copy application code
COPY . .

# Expose port
EXPOSE 3000

# Set default API URL (can be overridden at runtime via env vars)
ENV VITE_API_URL=http://192.168.2.186:8000/api/v1

# Start development server via entrypoint
ENTRYPOINT ["sh", "./entrypoint.sh"]
