FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy application code
COPY . .

# Set default API URL (can be overridden at runtime via env vars)
ENV VITE_API_URL=http://192.168.2.186:8000/api/v1

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]
