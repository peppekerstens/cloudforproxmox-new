# Proxmox ISP — Environment Configuration
# Copy this file to infra/.env and fill in your values.
# NEVER commit the actual .env file.

# ============================================================
# Proxmox API
# ============================================================
# Create an API token in Proxmox: Datacenter → Permissions → API Tokens
# Format: USER@REALM!TOKENID
PROXMOX_API_USER=root@pam
PROXMOX_API_TOKEN_ID=isp-portal
PROXMOX_API_TOKEN_VALUE=your-token-secret-here
PROXMOX_API_URL=https://<pve-ip>:8006/api2/json
PROXMOX_VERIFY_SSL=false

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://proxmoxisp:CHANGE_ME_DB_PASSWORD@localhost:5432/proxmoxisp

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/2

# ============================================================
# JWT Authentication
# ============================================================
# Generate a random 32+ character secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Frontend
# ============================================================
# Must be the external URL that browsers use to reach the API
VITE_API_URL=http://localhost:8000/api/v1
# CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Application
# ============================================================
APP_NAME=Proxmox ISP
APP_ENV=development
LOG_LEVEL=info
